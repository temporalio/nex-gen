{
  "note": "Cross-language conformance corpus for a PINNED, RE2-safe `email` format regex (JSON-Schema 2020-12 format-assertion candidate). The pinned regex captures a well-defined ASCII subset of RFC 5321 mailbox: an unquoted dot-atom local part, a single `@`, and a hostname-style domain (letter/digit/hyphen labels, dot-separated, >=2 labels, each label 1-63 chars, no leading/trailing hyphen). Deliberately EXCLUDED (rejected): quoted local parts (\"a b\"@x), comments, IP-literal domains ([192.0.2.1]), whitespace, control chars, internationalized (idn-email) addresses, single-label domains (a@b), trailing dot, and any Unicode. The regex is fully ANCHORED with ^...$; runners apply the pinned per-target anchor/flag normalization the `pattern` gate specifies. `expect_valid` is the intended verdict of the pinned check. Non-ASCII instances are raw UTF-8.",
  "pinned_regex": "^[a-zA-Z0-9!#$%&'*+/=?^_`{|}~-]+(?:\\.[a-zA-Z0-9!#$%&'*+/=?^_`{|}~-]+)*@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+$",
  "pairs": [
    {"id": "simple",                    "instance": "user@example.com",              "expect_valid": true},
    {"id": "subdomain",                 "instance": "user@mail.example.com",         "expect_valid": true},
    {"id": "plus-tag",                  "instance": "user+tag@example.com",          "expect_valid": true},
    {"id": "dots-in-local",             "instance": "first.last@example.com",        "expect_valid": true},
    {"id": "digit-local",              "instance": "123@example.com",               "expect_valid": true},
    {"id": "uppercase",                 "instance": "User.Name@Example.COM",         "expect_valid": true},
    {"id": "special-atext",             "instance": "a!#$%&'*+/=?^_`{|}~-@example.com", "expect_valid": true},
    {"id": "hyphen-in-domain",          "instance": "user@my-domain.example.com",    "expect_valid": true},
    {"id": "digit-domain-label",        "instance": "user@example123.com",           "expect_valid": true},
    {"id": "numeric-tld-like",          "instance": "user@host.123",                 "expect_valid": true},
    {"id": "single-char-labels",        "instance": "a@b.c",                         "expect_valid": true},
    {"id": "long-label-63",             "instance": "user@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com", "expect_valid": true},

    {"id": "no-at",                     "instance": "userexample.com",               "expect_valid": false},
    {"id": "two-at",                    "instance": "user@@example.com",             "expect_valid": false},
    {"id": "at-in-middle-two",          "instance": "us@er@example.com",             "expect_valid": false},
    {"id": "empty",                     "instance": "",                              "expect_valid": false},
    {"id": "local-only",                "instance": "user@",                         "expect_valid": false},
    {"id": "domain-only",               "instance": "@example.com",                  "expect_valid": false},
    {"id": "single-label-domain",       "instance": "user@localhost",               "expect_valid": false},
    {"id": "leading-dot-local",         "instance": ".user@example.com",             "expect_valid": false},
    {"id": "trailing-dot-local",        "instance": "user.@example.com",             "expect_valid": false},
    {"id": "double-dot-local",          "instance": "us..er@example.com",            "expect_valid": false},
    {"id": "leading-dot-domain",        "instance": "user@.example.com",             "expect_valid": false},
    {"id": "trailing-dot-domain",       "instance": "user@example.com.",             "expect_valid": false},
    {"id": "double-dot-domain",         "instance": "user@example..com",             "expect_valid": false},
    {"id": "leading-hyphen-label",      "instance": "user@-example.com",             "expect_valid": false},
    {"id": "trailing-hyphen-label",     "instance": "user@example-.com",             "expect_valid": false},
    {"id": "space-in-local",            "instance": "us er@example.com",             "expect_valid": false},
    {"id": "space-around",              "instance": " user@example.com ",            "expect_valid": false},
    {"id": "leading-space",             "instance": " user@example.com",             "expect_valid": false},
    {"id": "trailing-space",            "instance": "user@example.com ",             "expect_valid": false},
    {"id": "tab-in-local",              "instance": "us\ter@example.com",            "expect_valid": false},
    {"id": "newline-tail",              "instance": "user@example.com\n",            "expect_valid": false},
    {"id": "newline-embedded",          "instance": "user@exa\nmple.com",            "expect_valid": false},
    {"id": "quoted-local",              "instance": "\"user name\"@example.com",     "expect_valid": false},
    {"id": "quoted-at-local",           "instance": "\"user@name\"@example.com",     "expect_valid": false},
    {"id": "comment-local",             "instance": "user(comment)@example.com",     "expect_valid": false},
    {"id": "ip-literal-domain",         "instance": "user@[192.0.2.1]",              "expect_valid": false},

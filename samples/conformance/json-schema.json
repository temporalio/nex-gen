      "id": "numeric-bounds",
      "intent": "The inclusive boundary value is accepted; multipleOf over a number holds at 1e23 and 1e300; a number bound compares mathematically against an integral token above 2^53.",
      "schema": "samples/conformance/schemas/numeric-bounds.yaml",
      "model": "NumericBounds",
      "expected_load": {
        "result": "accepted"
      },
      "accepted_wire_values": [
        {
          "wire_json": "{\"boundedInt\":5,\"boundedNumber\":-1.5,\"gridFive\":0,\"gridThree\":0,\"exclusive\":0.5}"
        },
        {
          "wire_json": "{\"boundedInt\":10,\"boundedNumber\":9007199254740992,\"gridFive\":10,\"gridThree\":9,\"exclusive\":0.9999999999999999}"
        },
        {
          "wire_json": "{\"boundedInt\":7,\"boundedNumber\":0,\"gridFive\":0,\"gridThree\":1e300,\"exclusive\":0.5}",

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "function-execution/**/*.ts",
    "start-workflow/**/*.ts",
    "user-service/**/*.ts",
    "type-showcase/**/*.ts",
    "type-roundtrip/**/*.ts",
    "workflow-service/**/*.ts",
    "tests/**/*.ts"
  ]
}

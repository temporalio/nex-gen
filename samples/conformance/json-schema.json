    {
      "id": "integer-semantics",
      "intent": "Which wire tokens are integers (1, 1.0, 1e2, -0, +-(2^53-1)) and which are not (1.5, true, \"1\", 2^53, 2^53+1, a fractional literal above 2^52) - plus the serialize-side cap.",
      "schema": "samples/conformance/schemas/integer-semantics.yaml",
      "model": "IntegerSemantics",
      "expected_load": {
        "result": "accepted"
      },
      "accepted_wire_values": [
        {
          "wire_json": "{\"value\":1}"
        },
        {
          "wire_json": "{\"value\":1.0}",
          "expected_wire": "{\"value\":1}"
        },
        {
          "wire_json": "{\"value\":1e2}",
          "expected_wire": "{\"value\":100}"
        },
        {
          "wire_json": "{\"value\":-0}",
          "expected_wire": "{\"value\":0}"
        },
        {
          "wire_json": "{\"value\":9007199254740991}"
        },
        {
          "wire_json": "{\"value\":-9007199254740991}"
        }
      ],
      "parse_failures": [
        {
          "wire_json": "{\"value\":1.5}",
          "expected_paths": [
            "value"
          ]
        },
        {
          "wire_json": "{\"value\":true}",
          "expected_paths": [
            "value"
          ]
        },
        {
          "wire_json": "{\"value\":\"1\"}",
          "expected_paths": [
            "value"
          ]
        },
        {
          "wire_json": "{\"value\":9007199254740992}",
          "expected_paths": [
            "value"
          ]
        },
        {
          "wire_json": "{\"value\":9007199254740993}",
          "expected_paths": [
            "value"
          ]
        },
        {
          "wire_json": "{\"value\":4503599627370496.5}",
          "expected_paths": [
            "value"
          ]
        }
      ],
      "serialize_failures": [
        {
          "from_wire": "{\"value\":1}",
          "mutations": [
            {
              "path": "value",
              "set_integer": "9007199254740992"
            }
          ],
          "expected_paths": [
            "value"
          ]
        }
      ],
      "permitted_presence_nullability_collapse": [],
      "expected_divergence": {
        "findings": [
          "13#4"
        ],
        "status": "structural",
        "note": "4503599627370496.5 is rejected by Go and Java, which see the decimal text, and accepted by Python and TypeScript, which see the already-rounded double. TypeScript cannot recover the literal (D8), so the agreed accept set is bounded by it; narrowing Python alone would move the divergence rather than remove it.",
        "matches": [
          "parse_failures[5]"
        ]
      }
    },

    {
      "id": "content-encoding-canonical-form",
      "intent": "base64/base64url decode-encode must be the identity, so non-canonical trailing bits, missing padding, embedded whitespace and the wrong alphabet are all rejections.",
      "schema": "samples/conformance/schemas/content-encoding.yaml",

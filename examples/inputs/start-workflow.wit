package temporal:nexus@1.0.0;

world system {
  export start-workflow-service;
}

/// @nexus.endpoint "temporal-system"
interface start-workflow-service {
  use nexus:temporal-types/model@1.0.0.{duration, payloads, placeholder, task-queue, workflow-function};

  /// @nexus.proto "temporal.api.common.v1.WorkflowExecution" typescript-package="@temporalio/proto" dotnet-type="Temporalio.Api.Common.V1.WorkflowExecution"
  record workflow-execution {
    workflow-id: string,
    run-id: option<string>,
  }

  resource started-workflow {
    constructor(namespace: string, workflow-id: string, run-id: option<string>);

    /// @nexus.operation "cancel-workflow"
    cancel: func(reason: option<string>);
    restart-workflow: func(
      workflow: workflow-function,
      task-queue: task-queue,
    ) -> start-workflow-result;
    get-result: func() -> payloads;
  }

  /// @nexus.proto "temporal.api.workflowservice.v1.StartWorkflowExecutionRequest" typescript-package="@temporalio/proto" dotnet-type="Temporalio.Api.WorkflowService.V1.StartWorkflowExecutionRequest"
  record start-workflow-request {
    /// @nexus.proto-field "workflow_type"
    workflow: workflow-function,
    workflow-id: string,
    task-queue: task-queue,
    workflow-start-delay: option<duration>,
    /// @nexus.source python="workflow_namespace" typescript="workflowNamespace" dotnet="NexusApiGen.Support.TemporalWorkflowContext.WorkflowNamespace"
    namespace: string,
    /// @nexus.omit
    workflow-execution-timeout: placeholder,
    /// @nexus.omit
    workflow-run-timeout: placeholder,
    /// @nexus.omit
    workflow-task-timeout: placeholder,
    /// @nexus.omit
    identity: placeholder,
    /// @nexus.omit
    request-id: placeholder,
    /// @nexus.omit
    workflow-id-reuse-policy: placeholder,
    /// @nexus.omit
    workflow-id-conflict-policy: placeholder,
    /// @nexus.omit
    retry-policy: placeholder,
    /// @nexus.omit
    cron-schedule: placeholder,
    /// @nexus.omit
    memo: placeholder,
    /// @nexus.omit
    search-attributes: placeholder,
    /// @nexus.omit
    header: placeholder,
    /// @nexus.omit
    request-eager-execution: placeholder,
    /// @nexus.omit
    continued-failure: placeholder,
    /// @nexus.omit
    last-completion-result: placeholder,
    /// @nexus.omit
    completion-callbacks: placeholder,
    /// @nexus.omit
    user-metadata: placeholder,
    /// @nexus.omit
    links: placeholder,
    /// @nexus.omit
    versioning-override: placeholder,
    /// @nexus.omit
    on-conflict-options: placeholder,
    /// @nexus.omit
    priority: placeholder,
    /// @nexus.omit
    eager-worker-deployment-options: placeholder,
    /// @nexus.omit
    time-skipping-config: placeholder,
  }

  /// @nexus.proto "temporal.api.workflowservice.v1.StartWorkflowExecutionResponse" typescript-package="@temporalio/proto" dotnet-type="Temporalio.Api.WorkflowService.V1.StartWorkflowExecutionResponse"
  type start-workflow-result = own<started-workflow>;

  /// @nexus.proto "temporal.api.workflowservice.v1.RequestCancelWorkflowExecutionRequest" typescript-package="@temporalio/proto" dotnet-type="Temporalio.Api.WorkflowService.V1.RequestCancelWorkflowExecutionRequest"
  record cancel-workflow-request {
    /// @nexus.source python="workflow_namespace" typescript="workflowNamespace" dotnet="NexusApiGen.Support.TemporalWorkflowContext.WorkflowNamespace"
    namespace: string,
    workflow-execution: workflow-execution,
    reason: option<string>,
    /// @nexus.omit
    identity: placeholder,
    /// @nexus.omit
    request-id: placeholder,
    /// @nexus.omit
    first-execution-run-id: placeholder,
    /// @nexus.omit
    links: placeholder,
  }

  /// @nexus.proto "temporal.api.workflowservice.v1.RequestCancelWorkflowExecutionResponse" typescript-package="@temporalio/proto" dotnet-type="Temporalio.Api.WorkflowService.V1.RequestCancelWorkflowExecutionResponse"
  record cancel-workflow-response {
  }

  start-workflow: func(request: start-workflow-request) -> start-workflow-result;
  restart-workflow: func(request: start-workflow-request) -> start-workflow-result;

  cancel-workflow: func(request: cancel-workflow-request) -> cancel-workflow-response;
}

      "schema": "samples/schemas/showcase.nexusrpc.yaml",
      "model": "Showcase",
      "expected_load": {
        "result": "accepted"
      },
      "accepted_wire_values": [
        {
          "fixture": "samples/wire/json_schema/showcase/showcase-recursive-collections.json"
        }
      ],
      "parse_failures": [
        {
          "wire_json": "{\"kind\":\"showcase\",\"revision\":1,\"enabled\":true,\"status\":\"active\",\"tier\":1,\"scale\":1.5,\"name\":\"w\",\"count\":1,\"active\":true,\"category\":\"tools\",\"slots\":[\"x\"],\"links\":[\"not a uri\"]}",
          "expected_paths": [
            "links[0]",
            "slots[0]"
          ]
        }
      ],
      "serialize_failures": [
        {
          "from_fixture": "samples/wire/json_schema/showcase/showcase-recursive-collections.json",
          "mutations": [
            {
              "path": "numberGrid[0][1]",
              "set_number": "inf"
            }
          ],
          "expected_paths": [
            "numberGrid[0][1]"
          ]
        }
      ],
      "permitted_presence_nullability_collapse": [],
      "consumers": {
        "go": {
          "source": "samples/go/tests/json_schema_showcase_test.go",
          "anchor": "TestJSONSchemaShowcaseRecursiveCollections"
        },
        "typescript": {
          "source": "samples/typescript/tests/json-schema-showcase.test.ts",
          "anchor": "recursively converts collections and rejects non-finite numbers"
        },
        "python": {
          "source": "samples/python/tests/test_showcase.py",
          "anchor": "test_recursive_collections_and_non_finite_positions"
        },
        "java": {
          "source": "samples/java/src/test/java/jsonschema/JsonSchemaShowcaseRoundTripTest.java",
          "anchor": "recursiveCollectionsRoundTripAndRejectNonFiniteValues"
        }
      }
    },
    {
      "id": "mathematical-number-equality",
      "intent": "JSON number spelling is not identity-bearing: -0.0, 5e0, 1e3, the double extremes and a subnormal survive a round trip by mathematical value in every target.",
      "schema": "samples/schemas/showcase.nexusrpc.yaml",
      "model": "Showcase",
      "expected_load": {
        "result": "accepted"
      },
      "accepted_wire_values": [
        {
          "fixture": "samples/wire/json_schema/showcase/showcase-number-values.json"
        }
      ],
      "parse_failures": [],
      "serialize_failures": [],
      "permitted_presence_nullability_collapse": [],
      "consumers": {
        "go": {
          "source": "samples/go/tests/json_schema_showcase_test.go",
          "anchor": "TestJSONSchemaShowcaseNumberValueRoundTrip"
        },
        "typescript": {
          "source": "samples/typescript/tests/json-schema-showcase.test.ts",
          "anchor": "round-trips JSON numbers by mathematical value"
        },
        "python": {
          "source": "samples/python/tests/test_showcase.py",
          "anchor": "test_number_roundtrip_preserves_mathematical_values"
        },
        "java": {
          "source": "samples/java/src/test/java/jsonschema/JsonSchemaShowcaseRoundTripTest.java",
          "anchor": "numberSpellingsRoundTripByMathematicalValue"
        }
      },
      "expected_divergence": {
        "findings": [
          "new:ts-negative-zero"
        ],
        "status": "structural",
        "note": "JSON.stringify(-0) is \"0\" and the generated converter is handed an already-parsed value, so TypeScript cannot emit negative zero at all. The other three preserve it. Decision D8's class: the boundary is not the generator's to own, so this is documented rather than fixed.",
        "matches": [
          "typescript did not round-trip numberGrid[0][0]"
        ]
      }
    },
    {

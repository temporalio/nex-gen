{
  "note": "Tricky inputs for probing NATIVE URI parsers across 7 languages. Each entry is a candidate `uri` (JSON Schema 2020-12 format `uri` = RFC 3986 absolute URI, scheme REQUIRED). `rfc3986_verdict` is the author's best reading of strict RFC 3986 (absolute-URI: scheme ':' hier-part [ '?' query ] [ '#' fragment ] -- note RFC 3986 `absolute-URI` technically forbids a fragment, but JSON Schema `uri` = `URI` which ALLOWS a fragment; we use `uri`=URI-with-optional-fragment, scheme required). The point of this file is to expose DISAGREEMENT between native parsers, not to be a gold oracle. Non-ASCII written raw UTF-8.",
  "inputs": [
    {"id": "plain-http",              "value": "http://example.com",                 "note": "canonical absolute URI"},
    {"id": "http-with-path",          "value": "http://example.com/a/b?x=1#frag",    "note": "full components"},
    {"id": "mailto",                  "value": "mailto:user@example.com",            "note": "scheme + opaque path, no authority"},
    {"id": "urn",                     "value": "urn:isbn:0451450523",                "note": "urn scheme"},
    {"id": "custom-scheme",           "value": "x-y+z.1://host/p",                   "note": "scheme with allowed special chars + . -"},
    {"id": "ftp",                     "value": "ftp://ftp.example.com/file.txt",     "note": "ftp"},
    {"id": "file-triple-slash",       "value": "file:///etc/hosts",                  "note": "empty authority"},
    {"id": "tag-scheme",              "value": "tag:example.com,2024:foo",           "note": "tag scheme, opaque"},
    {"id": "data-uri",                "value": "data:text/plain;base64,SGVsbG8=",    "note": "data scheme"},

    {"id": "no-scheme-relative",      "value": "example.com/path",                   "note": "NO scheme -> must be REJECTED as uri (it is a relative reference)"},
    {"id": "no-scheme-abs-path",      "value": "/a/b/c",                             "note": "absolute-path relative ref, no scheme -> REJECT"},
    {"id": "protocol-relative",       "value": "//example.com/path",                 "note": "network-path relative ref, no scheme -> REJECT"},
    {"id": "just-fragment",           "value": "#frag",                              "note": "same-doc reference, no scheme -> REJECT"},
    {"id": "empty",                   "value": "",                                   "note": "empty -> REJECT"},
    {"id": "just-word",               "value": "hello",                             "note": "bare word, no colon -> REJECT"},

    {"id": "scheme-starts-digit",     "value": "1http://example.com",                "note": "scheme MUST start ALPHA -> REJECT"},
    {"id": "scheme-with-underscore",  "value": "ht_tp://example.com",                "note": "underscore not allowed in scheme -> REJECT"},
    {"id": "scheme-only-colon",       "value": "http:",                              "note": "scheme + empty path, valid minimal URI"},
    {"id": "scheme-colon-slash",      "value": "a:/",                                "note": "scheme + abs path"},

    {"id": "space-raw",               "value": "http://exa mple.com",                "note": "raw space -> REJECT (must be %20)"},
    {"id": "space-in-path",           "value": "http://example.com/a b",             "note": "raw space in path -> REJECT"},
    {"id": "backslash",               "value": "http://example.com\\path",           "note": "backslash not RFC3986 -> REJECT (but WHATWG URL normalizes it)"},
    {"id": "pct-valid",               "value": "http://example.com/%20%2F",          "note": "valid percent-encoding"},
    {"id": "pct-incomplete-1",        "value": "http://example.com/%2",              "note": "truncated percent-encoding -> REJECT (RFC3986: pct-encoded=%HEXDIG HEXDIG)"},
    {"id": "pct-incomplete-0",        "value": "http://example.com/%",               "note": "bare percent -> REJECT"},
    {"id": "pct-nonhex",              "value": "http://example.com/%zz",             "note": "non-hex after percent -> REJECT"},

    {"id": "brackets-in-path",        "value": "http://example.com/[abc]",           "note": "[] are gen-delims, only allowed as IP-literal delimiters, NOT in path -> REJECT per strict RFC3986"},
    {"id": "pipe-in-path",            "value": "http://example.com/a|b",             "note": "| not in RFC3986 unreserved/sub-delims/pchar -> REJECT"},
    {"id": "caret-in-query",          "value": "http://example.com/?a=^",            "note": "^ not a pchar -> REJECT"},
    {"id": "double-quote",            "value": "http://example.com/\"q\"",           "note": "double-quote not allowed -> REJECT"},
    {"id": "space-tab",               "value": "http://example.com/\t",              "note": "tab -> REJECT"},
    {"id": "newline",                 "value": "http://example.com/\nx",             "note": "newline -> REJECT"},

    {"id": "ipv4-host",               "value": "http://192.168.0.1/p",               "note": "IPv4 host"},
    {"id": "ipv6-host",               "value": "http://[2001:db8::1]/p",             "note": "IPv6 literal in brackets"},
    {"id": "ipv6-host-noport",        "value": "http://[::1]",                       "note": "IPv6 loopback"},
    {"id": "ipvfuture",               "value": "http://[v1.fe80::a]/p",              "note": "IPvFuture literal"},
    {"id": "ipv6-unbracketed",        "value": "http://2001:db8::1/p",               "note": "IPv6 without brackets -> REJECT (colons ambiguous with port)"},
    {"id": "host-with-port",          "value": "http://example.com:8080/p",          "note": "explicit port"},
    {"id": "host-empty-port",         "value": "http://example.com:/p",              "note": "empty port after colon, allowed (port = *DIGIT)"},
    {"id": "port-nondigit",           "value": "http://example.com:80a/p",           "note": "non-digit port -> REJECT"},
    {"id": "userinfo",                "value": "http://user:pass@example.com/p",     "note": "userinfo with password"},
    {"id": "userinfo-at-in-path",     "value": "http://example.com/a@b",             "note": "@ allowed as pchar in path"},

    {"id": "unicode-host",            "value": "http://exämple.com/p",               "note": "non-ASCII host -> REJECT for uri (that is IRI); RFC3986 host is ASCII"},
    {"id": "unicode-path",            "value": "http://example.com/café",            "note": "non-ASCII in path -> REJECT for uri (IRI territory)"},
    {"id": "emoji",                   "value": "http://example.com/😀",              "note": "astral emoji -> REJECT for uri"},

    {"id": "double-scheme",           "value": "http://http://x",                    "note": "weird but authority=http, path=//x arguably; lenient parsers accept"},
    {"id": "colon-then-slashes",      "value": "a://",                               "note": "scheme + empty authority + empty path"},
    {"id": "just-colon",              "value": ":",                                  "note": "empty scheme -> REJECT"},
    {"id": "just-colon-slashes",      "value": "://x",                               "note": "empty scheme -> REJECT"},
    {"id": "query-only-after-scheme", "value": "http:?q",                            "note": "scheme + empty path + query"},
    {"id": "fragment-after-scheme",   "value": "http:#f",                            "note": "scheme + empty path + fragment"},
    {"id": "uppercase-scheme",        "value": "HTTP://example.com",                 "note": "uppercase scheme allowed (scheme = ALPHA *(...))"},
    {"id": "trailing-space",          "value": "http://example.com ",               "note": "trailing space -> REJECT"},
    {"id": "leading-space",           "value": " http://example.com",               "note": "leading space -> REJECT"},
    {"id": "sub-delims-path",         "value": "http://example.com/a!$&'()*+,;=b",   "note": "all sub-delims are pchar -> ACCEPT"},
    {"id": "tilde-path",              "value": "http://example.com/~user",           "note": "~ is unreserved -> ACCEPT"},
    {"id": "at-in-userinfo-host",     "value": "http://a@b@example.com",             "note": "two @ -> ambiguous userinfo; strict RFC3986: userinfo has no @, so REJECT"}
  ]
}

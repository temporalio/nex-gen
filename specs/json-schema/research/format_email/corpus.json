    {"id": "underscore-in-domain",      "instance": "user@exa_mple.com",             "expect_valid": false},
    {"id": "label-64-too-long",         "instance": "user@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com", "expect_valid": false},

        },
        {
          "wire_json": "{\"boundedInt\":7,\"boundedNumber\":9007199254740993,\"gridFive\":0,\"gridThree\":0,\"exclusive\":0.5}",
          "expected_wire": "{\"boundedInt\":7,\"boundedNumber\":9007199254740992,\"gridFive\":0,\"gridThree\":0,\"exclusive\":0.5}"
        }
      ],
      "parse_failures": [
        {
          "wire_json": "{\"boundedInt\":4,\"boundedNumber\":0,\"gridFive\":0,\"gridThree\":0,\"exclusive\":0.5}",
          "expected_paths": [
            "boundedInt"
          ]
        },
        {
          "wire_json": "{\"boundedInt\":11,\"boundedNumber\":0,\"gridFive\":0,\"gridThree\":0,\"exclusive\":0.5}",
          "expected_paths": [
            "boundedInt"
          ]
        },
        {
          "wire_json": "{\"boundedInt\":7,\"boundedNumber\":9007199254740994,\"gridFive\":0,\"gridThree\":0,\"exclusive\":0.5}",
          "expected_paths": [
            "boundedNumber"
          ]
        },
        {
          "wire_json": "{\"boundedInt\":7,\"boundedNumber\":0,\"gridFive\":1e23,\"gridThree\":0,\"exclusive\":0.5}",
          "expected_paths": [
            "gridFive"
          ]
        },
        {
          "wire_json": "{\"boundedInt\":7,\"boundedNumber\":0,\"gridFive\":0,\"gridThree\":0,\"exclusive\":0}",
          "expected_paths": [
            "exclusive"
          ]
        },
        {
          "wire_json": "{\"boundedInt\":7,\"boundedNumber\":0,\"gridFive\":0,\"gridThree\":0,\"exclusive\":1}",
          "expected_paths": [
            "exclusive"
          ]
        },
        {
          "wire_json": "{\"boundedInt\":\"7\",\"boundedNumber\":0,\"gridFive\":0,\"gridThree\":0,\"exclusive\":0.5}",
          "expected_paths": [
            "boundedInt"
          ]
        },
        {
          "wire_json": "{\"boundedInt\":7,\"boundedNumber\":\"0\",\"gridFive\":0,\"gridThree\":0,\"exclusive\":0.5}",
          "expected_paths": [
